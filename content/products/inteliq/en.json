  "T10_faq": {
    "show": true,
    "h2": "Questions and answers about InteliQ",
    "items": [
      {
        "q": "What are InteliQ controls?",
        "a": "They are Bio-Rad liquid control materials in barcoded tubes for clinical chemistry and immunoassay testing."
      },
      {
        "q": "Which controls are included in the InteliQ range?",
        "a": "The range includes Assayed Multiqual, diabetes, homocysteine, immunology and tumor marker controls. Each is available in three levels."
      },
      {
        "q": "How should InteliQ controls be stored?",
        "a": "Closed vials remain stable for 3 years at −20…−70 °C. Once opened, stability is 7 days at 2–8 °C, according to manufacturer data for Assayed Multiqual and most analytes."
      },
      {
        "q": "Is InteliQ compatible with our analyzer?",
        "a": "Compatibility depends on the analyzer model. Send LabWell the model and analyte list so a manager can check compatibility and recommend controls."
      },
      {
        "q": "Who supplies InteliQ in Ukraine?",
        "a": "LabWell is a Bio-Rad partner and supplier in Ukraine."
      }
    ]
  },
